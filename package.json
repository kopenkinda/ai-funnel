{
  "name": "ai-funnel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:ui && go run ./cmd/funnel",
    "build": "pnpm build:ui && go build -o bin/ai-funnel ./cmd/funnel",
    "start": "./bin/ai-funnel",
    "lint": "oxlint --deny-warnings && go vet ./...",
    "lint:fix": "oxlint --deny-warnings --fix",
    "format": "prettier --write . && gofmt -w cmd internal",
    "format:check": "prettier --check . && test -z \"$(gofmt -l cmd internal)\"",
    "test": "go test ./... && node --test tests/*.test.ts",
    "test:ui": "playwright test",
    "build:ui": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@10.33.2"
}
